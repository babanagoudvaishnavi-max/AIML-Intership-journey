# Student Score Prediction

# 1. Import Libraries
import pandas as pd
import matplotlib.pyplot as plt

# 2. Load Dataset
data = pd.read_csv('../data/dataset.csv')
data.head()

# 3. Visualization
plt.scatter(data['Hours'], data['Score'])
plt.xlabel("Study Hours")
plt.ylabel("Score")
plt.title("Hours vs Score")
plt.show()
